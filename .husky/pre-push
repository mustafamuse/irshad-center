#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running lint check..."
bun run lint

if [ $? -ne 0 ]; then
  echo "Lint failed! Fix the errors before pushing."
  exit 1
fi

echo "🔨 Running production build check..."
bun run build

if [ $? -ne 0 ]; then
  echo "❌ Build failed! Fix the errors before pushing."
  exit 1
fi

echo "✅ Build successful!"
