{
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "analyze-codebase@claude-code-marketplace": true,
    "feature-dev@claude-plugins-official": true
  },
  "hooks": {},
  "permissions": {
    "ask": [
      "Edit(lib/services/shared/billing-service.ts)",
      "Edit(lib/services/webhooks/**)",
      "Edit(lib/stripe-*.ts)",
      "Edit(prisma/schema.prisma)",
      "Edit(prisma/migrations/**)",
      "Edit(lib/safe-action.ts)",
      "Edit(app/api/webhook/**)",
      "Edit(middleware.ts)"
    ],
    "deny": [
      "Bash(prisma migrate reset:*)",
      "Bash(bunx prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(bun prisma migrate reset:*)"
    ]
  }
}
